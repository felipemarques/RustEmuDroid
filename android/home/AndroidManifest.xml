<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.rustemudroid.home" android:versionCode="3" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="32"/>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <application android:label="RustEmuDroid Home" android:icon="@drawable/brand"
        android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <receiver android:name=".HomeLocaleReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
