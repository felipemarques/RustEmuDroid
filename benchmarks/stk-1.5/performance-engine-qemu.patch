+/*
+ * RustEmuDroid QA (A2 statistics and I fast path): decode a 32-bit MOV to or
+ * from memory (89 /r store, 8B /r load, C7 /0 imm32 store) from the
+ * instruction bytes of a memory-access exit. Only the instruction length,
+ * the register operand and the immediate are needed: the hardware already
+ * computed the guest physical address. Anything else (prefixes other than a
+ * REX without W, 16-bit code, other opcodes, register forms, TF/debug
+ * active, truncated bytes, direction mismatch) returns false.
+ */
+typedef struct WhpxQaMov {
+    uint8_t len;
+    uint8_t reg;      /* GPR number 0..15, WHvX64RegisterRax + reg */
+    bool is_write;
+    bool has_imm;
+    uint32_t imm;
+} WhpxQaMov;
+
+static bool whpx_qa_decode_mov32(const WHV_VP_EXIT_CONTEXT *vp,
+                                 const WHV_MEMORY_ACCESS_CONTEXT *ma,
+                                 WhpxQaMov *out)
+{
+    const uint8_t *b = ma->InstructionBytes;
+    const unsigned int n = MIN(ma->InstructionByteCount,
+                               sizeof(ma->InstructionBytes));
+    const bool long_mode = vp->Cs.Long;
+    unsigned int i = 0, disp = 0;
+    uint8_t rex = 0, op, modrm, mod, rm;
+
+    if (!vp->ExecutionState.Cr0Pe || vp->ExecutionState.DebugActive ||
+        (vp->Rflags & (1ULL << 8)) /* TF */) {
+        return false;
+    }
+    if (long_mode ? !vp->ExecutionState.EferLma : !vp->Cs.Default) {
+        return false; /* 16-bit code or inconsistent state */
+    }
+    if (ma->AccessInfo.AccessType != WHvMemoryAccessRead &&
+        ma->AccessInfo.AccessType != WHvMemoryAccessWrite) {
+        return false;
+    }
+    if (n < 2) {
+        return false;
+    }
+    if (long_mode && (b[0] & 0xf0) == 0x40) {
+        rex = b[i++];
+        if (rex & 0x08) {
+            return false; /* REX.W: 64-bit operand */
+        }
+    }
+    op = b[i++];
+    if (op != 0x89 && op != 0x8b && op != 0xc7) {
+        return false;
+    }
+    if (i >= n) {
+        return false;
+    }
+    modrm = b[i++];
+    mod = modrm >> 6;
+    rm = modrm & 7;
+    if (mod == 3 || (op == 0xc7 && ((modrm >> 3) & 7) != 0)) {
+        return false;
+    }
+    if (rm == 4) {
+        if (i >= n) {
+            return false;
+        }
+        if (mod == 0 && (b[i] & 7) == 5) {
+            disp = 4; /* SIB without base: disp32 */
+        }
+        i++;
+    } else if (mod == 0 && rm == 5) {
+        disp = 4; /* RIP-relative (64-bit) or absolute disp32 (32-bit) */
+    }
+    if (mod == 1) {
+        disp = 1;
+    } else if (mod == 2) {
+        disp = 4;
+    }
+    i += disp;
+    out->has_imm = (op == 0xc7);
+    if (out->has_imm) {
+        if (i + 4 > n) {
+            return false;
+        }
+        out->imm = (uint32_t)b[i] | ((uint32_t)b[i + 1] << 8) |
+                   ((uint32_t)b[i + 2] << 16) | ((uint32_t)b[i + 3] << 24);
+        i += 4;
+    }
+    if (i > n || i > 15) {
+        return false;
+    }
+    if (vp->InstructionLength && vp->InstructionLength != i) {
+        return false;
+    }
+    out->len = (uint8_t)i;
+    out->is_write = (op != 0x8b);
+    out->reg = ((modrm >> 3) & 7) | ((rex & 0x04) ? 8 : 0);
+    return out->is_write ==
+           (ma->AccessInfo.AccessType == WHvMemoryAccessWrite);
+}
+
+/* The value a decoded store writes (one register read unless immediate). */
+static bool whpx_qa_mov_store_value(CPUState *cpu, const WhpxQaMov *mv,
+                                    uint32_t *value)
+{
+    WHV_REGISTER_NAME name;
+    WHV_REGISTER_VALUE reg;
+
+    if (mv->has_imm) {
+        *value = mv->imm;
+        return true;
+    }
+    name = (WHV_REGISTER_NAME)(WHvX64RegisterRax + mv->reg);
+    if (FAILED(whp_dispatch.WHvGetVirtualProcessorRegisters(
+            whpx_global.partition, cpu->cpu_index, &name, 1, &reg))) {
+        return false;
+    }
+    *value = (uint32_t)reg.Reg64;
+    return true;
+}
+
+/* A2: LAPIC register/direction, and the ICR delivery mode/destination. */
+static int whpx_qa_lapic_sub(WhpxQaCpuStats *st, CPUState *cpu,
+                             WHV_RUN_VP_EXIT_CONTEXT *ctx)
+{
+    const bool w = ctx->MemoryAccess.AccessInfo.AccessType ==
+                   WHvMemoryAccessWrite;
+    WhpxQaMov mv;
+    uint32_t icr;
+
+    switch (ctx->MemoryAccess.Gpa & 0xff0) {
+    case 0xb0:
+        return w ? WHPX_QA_LAPIC_EOI_W : WHPX_QA_LAPIC_OTHER_R;
+    case 0x80:
+        return w ? WHPX_QA_LAPIC_TPR_W : WHPX_QA_LAPIC_TPR_R;
+    case 0x310:
+        return w ? WHPX_QA_LAPIC_ICRHI_W : WHPX_QA_LAPIC_OTHER_R;
+    case 0x320:
+        return w ? WHPX_QA_LAPIC_LVTT_W : WHPX_QA_LAPIC_LVTT_R;
+    case 0x380:
+        return w ? WHPX_QA_LAPIC_TMICT_W : WHPX_QA_LAPIC_TMICT_R;
+    case 0x390:
+        return w ? WHPX_QA_LAPIC_OTHER_W : WHPX_QA_LAPIC_TMCCT_R;
+    case 0x300:
+        if (!w) {
+            return WHPX_QA_LAPIC_OTHER_R;
+        }
+        if (!whpx_qa_decode_mov32(&ctx->VpContext, &ctx->MemoryAccess, &mv) ||
+            !whpx_qa_mov_store_value(cpu, &mv, &icr)) {
+            return WHPX_QA_LAPIC_ICRLO_UNKNOWN;
+        }
+        atomic_set(&st->icr_mode[(icr >> 8) & 7], st->icr_mode[(icr >> 8) & 7] + 1);
+        switch ((icr >> 18) & 3) {
+        case 1:
+            return WHPX_QA_LAPIC_ICRLO_SELF;
+        case 2:
+        case 3:
+            return WHPX_QA_LAPIC_ICRLO_BCAST;
+        default: {
+            /* Physical destination in ICR high bits 31:24 (racy read, stats). */
+            APICCommonState *s =
+                (APICCommonState *)X86_CPU(cpu)->apic_state;
+            if (!(icr & (1u << 11)) && s &&
+                (s->icr[1] >> 24) == X86_CPU(cpu)->apic_id) {
+                return WHPX_QA_LAPIC_ICRLO_SELF;
+            }
+            return WHPX_QA_LAPIC_ICRLO_OTHER;
+        }
+        }
+    default:
+        return w ? WHPX_QA_LAPIC_OTHER_W : WHPX_QA_LAPIC_OTHER_R;
+    }
+}
+
+static int whpx_qa_stats_classify(WhpxQaCpuStats *st, CPUState *cpu,
+                                  WHV_RUN_VP_EXIT_CONTEXT *ctx, int *lapic_sub)
+{
+    int bucket;
+
+    switch (ctx->ExitReason) {
+    case WHvRunVpExitReasonMemoryAccess:
+        bucket = whpx_qa_mmio_bucket(st, ctx->MemoryAccess.Gpa);
+        if (bucket == WHPX_QA_EXIT_MMIO_LAPIC) {
+            *lapic_sub = whpx_qa_lapic_sub(st, cpu, ctx);
+        }
+        return bucket;
+    case WHvRunVpExitReasonX64IoPortAccess:
+        whpx_qa_count_key(st, ((uint64_t)ctx->IoPortAccess.PortNumber << 2) |
+                          WHPX_QA_KEY_IO);
+        return WHPX_QA_EXIT_IO;
+    case WHvRunVpExitReasonX64Halt:
+        return WHPX_QA_EXIT_HLT;
+    case WHvRunVpExitReasonCanceled:
+        return WHPX_QA_EXIT_CANCELED;
+    case WHvRunVpExitReasonX64InterruptWindow:
+        return WHPX_QA_EXIT_IRQ_WINDOW;
+    case WHvRunVpExitReasonX64MsrAccess:
+        return WHPX_QA_EXIT_MSR;
+    case WHvRunVpExitReasonX64Cpuid:
+        return WHPX_QA_EXIT_CPUID;
+    default:
+        return WHPX_QA_EXIT_OTHER;
+    }
+}
+
+static int whpx_qa_slot_cmp(const void *a, const void *b)
+{
+    const WhpxQaSlot *x = a, *y = b;
+    return x->count < y->count ? 1 : x->count > y->count ? -1 : 0;
+}
+
+static void *whpx_qa_stats_thread_fn(void *opaque)
+{
+    const unsigned int n = whpx_qa_stats_ncpus;
+    const size_t words = n * sizeof(WhpxQaCpuStats) / sizeof(uint64_t);
+    WhpxQaCpuStats *prev = g_new0(WhpxQaCpuStats, n);
+    WhpxQaCpuStats *cur = g_new0(WhpxQaCpuStats, n);
+    WhpxQaSlot *merged = g_new0(WhpxQaSlot, n * WHPX_QA_TOP_SLOTS);
+    uint64_t last = whpx_qa_now();
+    LARGE_INTEGER freq;
+    double us;
+
+    QueryPerformanceFrequency(&freq);
+    us = 1e6 / (double)freq.QuadPart;
+    /* memory_region_find() below takes the RCU read lock. */
+    rcu_register_thread();
+
+    for (;;) {
+        uint64_t count[WHPX_QA_EXIT_NR] = {0}, ticks[WHPX_QA_EXIT_NR] = {0};
+        uint64_t total = 0, mmio = 0, now;
+        const uint64_t *src = (const uint64_t *)whpx_qa_stats;
+        uint64_t *dst = (uint64_t *)cur;
+        unsigned int c, i, j, merged_n = 0;
+        char line[1024];
+        int len;
+
+        Sleep(whpx_qa_stats_interval_ms);
+        for (i = 0; i < words; i++) {
+            dst[i] = atomic_read(&src[i]);
+        }
+        now = whpx_qa_now();
+        atomic_set(&whpx_qa_stats_gen, whpx_qa_stats_gen + 1);
+
+        for (c = 0; c < n; c++) {
+            for (i = 0; i < WHPX_QA_EXIT_NR; i++) {
+                count[i] += cur[c].count[i] - prev[c].count[i];
+                ticks[i] += cur[c].ticks[i] - prev[c].ticks[i];
+            }
+            for (i = 0; i < WHPX_QA_TOP_SLOTS; i++) {
+                uint64_t key = cur[c].top[i].key;
+                /* A slot's key never changes once set (count is stored
+                 * before key), so the count delta is always valid. */
+                uint64_t delta = cur[c].top[i].count - prev[c].top[i].count;
+                if (!key || !delta) {
+                    continue;
+                }
+                for (j = 0; j < merged_n && merged[j].key != key; j++) {
+                }
+                if (j == merged_n) {
+                    merged[merged_n].key = key;
+                    merged[merged_n++].count = 0;
+                }
+                merged[j].count += delta;
+            }
+        }
+        for (i = 0; i < WHPX_QA_EXIT_NR; i++) {
+            total += count[i];
+            if (i <= WHPX_QA_EXIT_MMIO_OTHER) {
+                mmio += count[i];
+            }
+        }
+
+        len = snprintf(line, sizeof(line),
+                       "WHPX EXIT QA: dt_ms=%.0f exits=%" PRIu64
+                       " mmio=%" PRIu64, (now - last) * us / 1e3, total, mmio);
+        for (i = 0; i < WHPX_QA_EXIT_NR && len > 0 &&
+                    len < (int)sizeof(line); i++) {
+            if (count[i]) {
+                len += snprintf(line + len, sizeof(line) - len,
+                                " %s=%" PRIu64 "/%.0fus", whpx_qa_exit_names[i],
+                                count[i], ticks[i] * us);
+            }
+        }
+        if (merged_n && len > 0 && len < (int)sizeof(line)) {
+            qsort(merged, merged_n, sizeof(*merged), whpx_qa_slot_cmp);
+            len += snprintf(line + len, sizeof(line) - len, " top:");
+            for (j = 0; j < merged_n && j < 6 && len > 0 &&
+                        len < (int)sizeof(line); j++) {
+                uint64_t key = merged[j].key;
+                if ((key & 3) == WHPX_QA_KEY_MMIO) {
+                    /* A2: name the region behind the page. */
+                    MemoryRegionSection sec = memory_region_find(
+                        get_system_memory(), key & ~3ULL, 1);
+                    const char *rname = sec.mr ? memory_region_name(sec.mr) : NULL;
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " gpa:%" PRIx64 "=%" PRIu64 "(%s+0x%" PRIx64
+                                    "%s)", key & ~3ULL, merged[j].count,
+                                    rname ? rname : "unassigned",
+                                    sec.mr ? (uint64_t)sec.offset_within_region : 0,
+                                    sec.mr && memory_region_is_ram(sec.mr) ?
+                                        ",ram" : "");
+                    if (sec.mr) {
+                        memory_region_unref(sec.mr);
+                    }
+                } else {
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " port:%" PRIx64 "=%" PRIu64, key >> 2,
+                                    merged[j].count);
+                }
+            }
+        }
+        fprintf(stderr, "%s\n", line);
+
+        /* A2: LAPIC breakdown, ICR delivery modes, kicks, fast path, polls. */
+        {
+            uint64_t lc[WHPX_QA_LAPIC_NR] = {0}, lt[WHPX_QA_LAPIC_NR] = {0};
+            uint64_t im[8] = {0}, fh = 0, ff = 0, ks = 0, kv = 0, ko = 0;
+            uint64_t ph = 0, pm = 0, nl = 0, nk = 0, es = 0, et = 0, ec = 0;
+            for (c = 0; c < n; c++) {
+                nl += cur[c].prerun_lockless - prev[c].prerun_lockless;
+                nk += cur[c].prerun_locked - prev[c].prerun_locked;
+                es += cur[c].pv_eoi_set - prev[c].pv_eoi_set;
+                et += cur[c].pv_eoi_taken - prev[c].pv_eoi_taken;
+                ec += cur[c].pv_eoi_cleared - prev[c].pv_eoi_cleared;
+                for (i = 0; i < WHPX_QA_LAPIC_NR; i++) {
+                    lc[i] += cur[c].lapic_count[i] - prev[c].lapic_count[i];
+                    lt[i] += cur[c].lapic_ticks[i] - prev[c].lapic_ticks[i];
+                }
+                for (i = 0; i < 8; i++) {
+                    im[i] += cur[c].icr_mode[i] - prev[c].icr_mode[i];
+                }
+                fh += cur[c].lapic_fast_hit - prev[c].lapic_fast_hit;
+                ff += cur[c].lapic_fast_fallback - prev[c].lapic_fast_fallback;
+                ks += cur[c].kick_self - prev[c].kick_self;
+                kv += cur[c].kick_vcpu - prev[c].kick_vcpu;
+                ko += cur[c].kick_other - prev[c].kick_other;
+                ph += cur[c].hlt_poll_hit - prev[c].hlt_poll_hit;
+                pm += cur[c].hlt_poll_miss - prev[c].hlt_poll_miss;
+            }
+            len = snprintf(line, sizeof(line), "WHPX EXIT QA lapic:");
+            for (i = 0; i < WHPX_QA_LAPIC_NR && len > 0 &&
+                        len < (int)sizeof(line); i++) {
+                if (lc[i]) {
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " %s=%" PRIu64 "/%.0fus",
+                                    whpx_qa_lapic_names[i], lc[i], lt[i] * us);
+                }
+            }
+            for (i = 0; i < 8 && len > 0 && len < (int)sizeof(line); i++) {
+                if (im[i]) {
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " icr-%s=%" PRIu64,
+                                    whpx_qa_icr_mode_names[i], im[i]);
+                }
+            }
+            if (len > 0 && len < (int)sizeof(line)) {
+                len += snprintf(line + len, sizeof(line) - len,
+                                " fast=%" PRIu64 "/fallback=%" PRIu64
+                                " kicks: self=%" PRIu64 " from-vcpu=%" PRIu64
+                                " from-other=%" PRIu64 " hlt-poll: hit=%"
+                                PRIu64 " miss=%" PRIu64,
+                                fh, ff, ks, kv, ko, ph, pm);
+            }
+            if (len > 0 && len < (int)sizeof(line)) {
+                len += snprintf(line + len, sizeof(line) - len,
+                                " prerun: lockless=%" PRIu64 " locked=%" PRIu64
+                                " pv-eoi: set=%" PRIu64 " taken=%" PRIu64
+                                " withdrawn=%" PRIu64, nl, nk, es, et, ec);
+            }
+            if (len > 0 && len < (int)sizeof(line)) {
+                uint64_t mh = 0, mf = 0;
+                for (c = 0; c < n; c++) {
+                    mh += cur[c].mmio_fast_hit - prev[c].mmio_fast_hit;
+                    mf += cur[c].mmio_fast_fallback - prev[c].mmio_fast_fallback;
+                }
+                len += snprintf(line + len, sizeof(line) - len,
+                                " mmio-fast=%" PRIu64 "/fallback=%" PRIu64,
+                                mh, mf);
+            }
+            fprintf(stderr, "%s\n", line);
+        }
+
+        /* A2: per-vCPU totals. */
+        for (c = 0; c < n; c++) {
+            uint64_t ce = 0, ct = 0;
+            for (i = 0; i < WHPX_QA_EXIT_NR; i++) {
+                ce += cur[c].count[i] - prev[c].count[i];
+                ct += cur[c].ticks[i] - prev[c].ticks[i];
+            }
+            if (!ce) {
+                continue;
+            }
+            len = snprintf(line, sizeof(line),
+                           "WHPX EXIT QA vcpu%u: exits=%" PRIu64 " handler=%.0fus",
+                           c, ce, ct * us);
+            for (i = 0; i < WHPX_QA_EXIT_NR && len > 0 &&
+                        len < (int)sizeof(line); i++) {
+                uint64_t d = cur[c].count[i] - prev[c].count[i];
+                if (d) {
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " %s=%" PRIu64 "/%.0fus", whpx_qa_exit_names[i],
+                                    d, (cur[c].ticks[i] - prev[c].ticks[i]) * us);
+                }
+            }
+            for (i = 0; i < WHPX_QA_LAPIC_NR && len > 0 &&
+                        len < (int)sizeof(line); i++) {
+                uint64_t d = cur[c].lapic_count[i] - prev[c].lapic_count[i];
+                if (d) {
+                    len += snprintf(line + len, sizeof(line) - len,
+                                    " l.%s=%" PRIu64, whpx_qa_lapic_names[i], d);
+                }
+            }
+            if (len > 0 && len < (int)sizeof(line)) {
+                len += snprintf(line + len, sizeof(line) - len,
+                                " kicks=%" PRIu64 "/%" PRIu64 "/%" PRIu64,
+                                cur[c].kick_self - prev[c].kick_self,
+                                cur[c].kick_vcpu - prev[c].kick_vcpu,
+                                cur[c].kick_other - prev[c].kick_other);
+            }
+            if (len > 0 && len < (int)sizeof(line)) {
+                /* A3: loop overhead outside the handlers, run-time histogram. */
+                len += snprintf(line + len, sizeof(line) - len,
+                                " prerun=%.0fus postrun=%.0fus run<2/4/8/16/32/+="
+                                "%" PRIu64 "/%" PRIu64 "/%" PRIu64 "/%" PRIu64
+                                "/%" PRIu64 "/%" PRIu64,
+                                (cur[c].prerun_ticks - prev[c].prerun_ticks) * us,
+                                (cur[c].postrun_ticks - prev[c].postrun_ticks) * us,
+                                cur[c].run_hist[0] - prev[c].run_hist[0],
+                                cur[c].run_hist[1] - prev[c].run_hist[1],
+                                cur[c].run_hist[2] - prev[c].run_hist[2],
+                                cur[c].run_hist[3] - prev[c].run_hist[3],
+                                cur[c].run_hist[4] - prev[c].run_hist[4],
+                                cur[c].run_hist[5] - prev[c].run_hist[5]);
+            }
+            fprintf(stderr, "%s\n", line);
+        }
+        fflush(stderr);
+
+        memcpy(prev, cur, n * sizeof(*cur));
+        last = now;
+    }
+    return NULL;
+}
+
+static void whpx_qa_stats_init(void)
+{
+    const char *env = getenv("RUSTEMUDROID_QA_WHPX_EXIT_STATS");
+    int ms;
+
+    if (!env || (ms = atoi(env)) <= 0) {
+        return;
+    }
+    if (ms < 100) {
+        ms = 100;
+    }
+    whpx_qa_stats_interval_ms = ms;
+    {
+        LARGE_INTEGER f;
+        QueryPerformanceFrequency(&f);
+        whpx_qa_ticks_per_us = (uint64_t)(f.QuadPart / 1000000);
+        if (!whpx_qa_ticks_per_us) {
+            whpx_qa_ticks_per_us = 1;
+        }
+    }
+    whpx_qa_stats_ncpus = max_cpus;
+    whpx_qa_stats = g_new0(WhpxQaCpuStats, whpx_qa_stats_ncpus);
+    qemu_thread_create(&whpx_qa_stats_thread, "whpx-qa-stats",
+                       whpx_qa_stats_thread_fn, NULL, QEMU_THREAD_DETACHED);
+    qa_info_report("WHPX EXIT QA: exit statistics active interval_ms=%d vcpus=%u",
+                ms, whpx_qa_stats_ncpus);
+}
