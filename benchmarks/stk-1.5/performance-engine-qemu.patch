+
+/*
+ * RustEmuDroid QA P0: one-time proof lines. Same text as vreport() prints
+ * ("[timestamp ]progname: [warning: |info: ]message\n"), but built in memory,
+ * written with a single fputs (so another writer cannot split the line) and
+ * followed by fflush(stderr) (stderr is fully buffered on Windows after
+ * os_set_line_buffering()). With a monitor or a non-default location the
+ * stock vreport() runs and stderr is flushed afterwards.
+ */
+static void qa_vreport(report_type type, const char *fmt, va_list ap)
+{
+    GString *s;
+    gchar *msg;
+
+    if (cur_mon || cur_loc->kind != LOC_NONE) {
+        vreport(type, fmt, ap);
+        fflush(stderr);
+        return;
+    }
+    s = g_string_new(NULL);
+    if (enable_timestamp_msg) {
+        GTimeVal tv;
+        gchar *timestr;
+
+        g_get_current_time(&tv);
+        timestr = g_time_val_to_iso8601(&tv);
+        g_string_append_printf(s, "%s ", timestr);
+        g_free(timestr);
+    }
+    if (progname) {
+        g_string_append_printf(s, "%s: ", progname);
+    }
+    if (type == REPORT_TYPE_WARNING) {
+        g_string_append(s, "warning: ");
+    } else if (type == REPORT_TYPE_INFO) {
+        g_string_append(s, "info: ");
+    }
+    msg = g_strdup_vprintf(fmt, ap);
+    g_string_append(s, msg);
+    g_free(msg);
+    g_string_append_c(s, '\n');
+    fputs(s->str, stderr);
+    fflush(stderr);
+    g_string_free(s, TRUE);
+}
+
+void qa_error_report(const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    qa_vreport(REPORT_TYPE_ERROR, fmt, ap);
+    va_end(ap);
+}
+
+void qa_warn_report(const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    qa_vreport(REPORT_TYPE_WARNING, fmt, ap);
+    va_end(ap);
+}
+
+void qa_info_report(const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    qa_vreport(REPORT_TYPE_INFO, fmt, ap);
+    va_end(ap);
+}
