+static void qa_pipe_dev_write(void* opaque,
+                              hwaddr offset,
+                              uint64_t value,
+                              unsigned size) {
+    GoldfishPipeState* state = opaque;
+    PipeDevice* dev = state->dev;
+    const bool had_bql = qemu_mutex_iothread_locked();
