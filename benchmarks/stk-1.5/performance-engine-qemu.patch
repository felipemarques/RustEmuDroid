+        (err = GetLastError()) != ERROR_SUCCESS) {
+        err = GetLastError();
+        CloseHandle(token);
+        qa_info_report("RustEmuDroid QA: guest RAM large pages unavailable "
+                    "(%s, error %lu), using stock allocation",
+                    err == ERROR_NOT_ALL_ASSIGNED ?
+                        "SeLockMemoryPrivilege is not held by this account" :
+                        "AdjustTokenPrivileges failed",
+                    err);
+        return NULL;
+    }
+    CloseHandle(token);
+
+    rounded = (size + large - 1) & ~((size_t)large - 1);
+    ptr = VirtualAlloc(NULL, rounded, MEM_RESERVE | MEM_COMMIT | MEM_LARGE_PAGES,
+                       PAGE_READWRITE);
+    if (!ptr) {
+        err = GetLastError();
+        qa_info_report("RustEmuDroid QA: guest RAM large pages unavailable "
+                    "(VirtualAlloc(MEM_LARGE_PAGES, %zu MiB) error %lu%s), "
+                    "using stock allocation",
+                    rounded >> 20, err,
+                    err == ERROR_NO_SYSTEM_RESOURCES ?
+                        ": not enough contiguous physical memory" : "");
+        return NULL;
+    }
+    qa_info_report("RustEmuDroid QA: guest RAM large pages active, %zu MiB in "
+                "%zu KiB pages", rounded >> 20, (size_t)(large >> 10));
+    return ptr;
+}
+
+/*
+ * RustEmuDroid QA L2 (RUSTEMUDROID_QA_RAM_SECTION=<name>): map the guest's
+ * main RAM block (the only anonymous block >= 1 GiB) from a named,
+ * pagefile-backed SEC_LARGE_PAGES section created by a privileged helper.
+ * Returns NULL after logging the reason; the caller then continues with L
+ * or the stock allocation.
+ */
+#ifndef FILE_MAP_LARGE_PAGES
+#define FILE_MAP_LARGE_PAGES 0x20000000
+#endif
+
+static void *qa_section_view;      /* base of the mapped view, if any */
+
+static void qa_section_unavailable(const char *name, const char *why,
+                                   DWORD err)
+{
+    if (err) {
+        qa_info_report("RustEmuDroid QA: guest RAM section %s unavailable (%s,"
+                    " Win32 error %lu), using stock allocation", name, why, err);
+    } else {
+        qa_info_report("RustEmuDroid QA: guest RAM section %s unavailable (%s),"
+                    " using stock allocation", name, why);
+    }
+}
+
+static void *qa_section_ram_alloc(size_t size)
+{
+    static int s_checked = 0;
+    static const char *s_name = NULL;
+    wchar_t wname[256];
+    SIZE_T large;
+    size_t rounded;
+    HANDLE section;
+    void *ptr;
+    MEMORY_BASIC_INFORMATION mbi;
+    const char *large_state = "unknown";
+    DWORD err;
+
+    if (!s_checked) {
+        s_checked = 1;
+        s_name = getenv("RUSTEMUDROID_QA_RAM_SECTION");
+        if (s_name && !*s_name) {
+            s_name = NULL;
+        }
+    }
+    if (!s_name || size < RUSTEMUDROID_QA_LARGE_PAGES_MIN_BLOCK ||
+        qa_section_view) {
+        return NULL;
+    }
+    large = GetLargePageMinimum();
+    if (!large) {
+        qa_section_unavailable(s_name, "GetLargePageMinimum() returned 0", 0);
+        return NULL;
+    }
+    rounded = (size + large - 1) & ~((size_t)large - 1);
+    if (!MultiByteToWideChar(CP_UTF8, 0, s_name, -1, wname,
+                             (int)(sizeof(wname) / sizeof(wname[0])))) {
+        qa_section_unavailable(s_name, "invalid section name", GetLastError());
+        return NULL;
+    }
+    section = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, wname);
+    if (!section) {
+        err = GetLastError();
+        qa_section_unavailable(s_name, err == ERROR_FILE_NOT_FOUND ?
+                               "section does not exist (helper not running?)" :
+                               "OpenFileMappingW failed", err);
+        return NULL;
+    }
+    ptr = MapViewOfFileEx(section,
+                          FILE_MAP_READ | FILE_MAP_WRITE | FILE_MAP_LARGE_PAGES,
+                          0, 0, rounded, NULL);
+    err = ptr ? 0 : GetLastError();
+    CloseHandle(section); /* the view keeps the section alive */
+    if (!ptr) {
+        char why[160];
+        snprintf(why, sizeof(why),
+                 "MapViewOfFileEx(FILE_MAP_LARGE_PAGES, %zu MiB) failed%s",
+                 rounded >> 20,
+                 err == ERROR_PRIVILEGE_NOT_HELD ?
+                     ": privilege required at map time" :
+                 err == ERROR_ACCESS_DENIED ?
+                     ": access denied or section smaller than the RAM block" :
+                 "");
+        qa_section_unavailable(s_name, why, err);
+        return NULL;
+    }
+    if (!VirtualQuery(ptr, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT ||
+        mbi.Type != MEM_MAPPED || mbi.RegionSize < rounded) {
+        UnmapViewOfFile(ptr);
+        qa_section_unavailable(s_name, "VirtualQuery: view is not a committed"
+                               " mapping of the full size", GetLastError());
+        return NULL;
+    }
+    /* The section may have been used by an earlier VM: zero it (this also
+     * makes every page resident, which QueryWorkingSetEx below needs). */
+    memset(ptr, 0, rounded);
+    {
+        PSAPI_WORKING_SET_EX_INFORMATION ws[3];
+        int i, large_count = 0, valid_count = 0;
+        memset(ws, 0, sizeof(ws));
+        ws[0].VirtualAddress = ptr;
+        ws[1].VirtualAddress = (uint8_t *)ptr + (rounded / 2);
+        ws[2].VirtualAddress = (uint8_t *)ptr + rounded - 4096;
+        if (QueryWorkingSetEx(GetCurrentProcess(), ws, sizeof(ws))) {
+            for (i = 0; i < 3; i++) {
+                if (ws[i].VirtualAttributes.Valid) {
+                    valid_count++;
+                    large_count += ws[i].VirtualAttributes.LargePage ? 1 : 0;
+                }
+            }
+            if (valid_count == 3) {
+                large_state = large_count == 3 ? "yes" :
+                              large_count == 0 ? "no" : "partial";
+            }
+        }
+    }
+    qa_section_view = ptr;
+    qa_info_report("RustEmuDroid QA: guest RAM mapped from section %s, %zu MiB,"
+                " large pages=%s", s_name, rounded >> 20, large_state);
+    return ptr;
+}
+
 void *qemu_anon_ram_alloc(size_t size, uint64_t *align, bool shared)
 {
     void *ptr;
 
+    ptr = qa_section_ram_alloc(size);
+    if (ptr) {
+        trace_qemu_anon_ram_alloc(size, ptr);
+        return ptr;
+    }
+
+    ptr = qa_large_page_ram_alloc(size);
+    if (ptr) {
+        trace_qemu_anon_ram_alloc(size, ptr);
+        return ptr;
+    }
+
     /* FIXME: this is not exactly optimal solution since VirtualAlloc
        has 64Kb granularity, but at least it guarantees us that the
        memory is page aligned. */
@@ -146,6 +367,12 @@ void qemu_vfree(void *ptr)
 void qemu_anon_ram_free(void *ptr, size_t size)
 {
     trace_qemu_anon_ram_free(ptr, size);
+    if (ptr && ptr == qa_section_view) {
+        /* RustEmuDroid QA L2: a section view, not a VirtualAlloc block. */
+        UnmapViewOfFile(ptr);
+        qa_section_view = NULL;
+        return;
+    }
     if (ptr) {
         VirtualFree(ptr, 0, MEM_RELEASE);
     }
