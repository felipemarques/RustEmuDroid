+    qemu_mutex_lock(&dev->qa_lock);
+    if (!had_bql) {
+        qemu_mutex_lock_iothread();
+    }
+    res = pipe_dev_read(opaque, offset, size);
+    if (!had_bql) {
+        qemu_mutex_unlock_iothread();
+    }
+    qemu_mutex_unlock(&dev->qa_lock);
