+    }
+    /* Other regions (e.g. PCI BARs) by name; cached for one interval. */
+    i = (unsigned int)((page >> 12) * 0x9E3779B1u) % WHPX_QA_CLASS_SLOTS;
+    gen = atomic_read(&whpx_qa_stats_gen);
+    if (st->class_page[i] == page && st->class_gen[i] == gen) {
+        bucket = st->class_bucket[i];
+    } else {
+        bucket = whpx_qa_mmio_bucket_slow(gpa);
+        st->class_page[i] = page;
+        st->class_gen[i] = gen;
+        st->class_bucket[i] = (uint8_t)bucket;
+    }
+    if (bucket == WHPX_QA_EXIT_MMIO_OTHER) {
+        whpx_qa_count_key(st, page | WHPX_QA_KEY_MMIO);
+    }
+    return bucket;
+}
