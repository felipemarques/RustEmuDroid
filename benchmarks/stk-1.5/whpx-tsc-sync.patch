+void whpx_qa_synchronize_tsc(const char *phase)
+{
+    struct whpx_state *whpx = &whpx_global;
+    CPUState *cpu;
+    HRESULT hr;
+    unsigned int written = 0;
+    const WHV_REGISTER_NAME register_name = WHvX64RegisterTsc;
+
+    if (!whpx_qa_suspend_partition_time) {
+        return;
+    }
+
+    /* The post-init/reset caller owns the iothread lock. A parked VP cannot
+     * enter WHvRunVirtualProcessor and resume partition time during the batch. */
+    if (!qemu_mutex_iothread_locked()) {
+        error_report("WHPX TSC QA: missing iothread lock at %s", phase);
+        exit(EXIT_FAILURE);
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped) {
+            error_report("WHPX TSC QA: vCPU %d is not stopped at %s",
+                         cpu->cpu_index, phase);
+            exit(EXIT_FAILURE);
+        }
+    }
+
+    hr = whpx_qa_suspend_partition_time(whpx->partition);
+    if (FAILED(hr)) {
+        error_report("WHPX TSC QA: suspend failed at %s, hr=%08lx", phase, hr);
+        exit(EXIT_FAILURE);
+    }
+
+    CPU_FOREACH(cpu) {
+        CPUX86State *env = (CPUArchState *)(cpu->env_ptr);
+        WHV_REGISTER_VALUE value;
+        value.Reg64 = env->tsc;
+        hr = whp_dispatch.WHvSetVirtualProcessorRegisters(
+            whpx->partition, cpu->cpu_index, &register_name, 1, &value);
+        if (FAILED(hr)) {
+            error_report("WHPX TSC QA: write failed at %s, vCPU %d, hr=%08lx",
+                         phase, cpu->cpu_index, hr);
+            exit(EXIT_FAILURE);
+        }
+        ++written;
+    }
+    /* WHvRunVirtualProcessor resumes time after the complete batch. */
+    info_report("WHPX TSC QA: synchronized %s vcpus=%u", phase, written);
+}
