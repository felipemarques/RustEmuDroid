+// RustEmuDroid QA (RUSTEMUDROID_QA_ASG_SPIN_US=<n>, 1..5000): the consumer polls
+// the rings for up to n microseconds per idle period before it goes through the
+// stock unavailable-read path (NEED_NOTIFY + sleep), and an arrival of data
+// resets mUnavailableReadCount. Read once; 0 (default) keeps the stock path.
+int64_t RustEmuDroidQaAsgSpinUs() {
+    static const int64_t sSpinUs = [] {
+        const char* env = getenv("RUSTEMUDROID_QA_ASG_SPIN_US");
+        long long us = env ? atoll(env) : 0;
+        if (us <= 0) {
+            return (int64_t)0;
+        }
+        if (us > 5000) {
+            us = 5000;
+        }
+        GFXSTREAM_WARNING("RustEmuDroid QA: ASG consumer spin active, spin_us=%lld", us);
+        return (int64_t)us;
+    }();
+    return sSpinUs;
+}
+
+// RustEmuDroid QA P (RUSTEMUDROID_QA_ASG_SPIN_RENDERING=1, needs
+// RUSTEMUDROID_QA_ASG_SPIN_US > 0): while the consumer polls inside its spin
+// window it advertises ASG_HOST_STATE_RENDERING instead of CAN_CONSUME. The
+// guest (AddressSpaceStream::type1Write / writeFully) pings after every
+// commit unless the state is RENDERING, so this removes the ping (one MMIO
+// exit) per commit while the host is awake anyway. At the end of the window
+// the state goes back to CAN_CONSUME and polling continues for
+// kQaSpinRenderingGraceUs before the stock sleep path; that grace closes the
+// race of a guest that read RENDERING just before the switch while its ring
+// store was still in its store buffer (the guest has no fence between the
+// store and the state load).
+constexpr int64_t kQaSpinRenderingGraceUs = 100;
+
+bool RustEmuDroidQaAsgSpinRendering() {
+    static const bool sOn = [] {
+        const char* env = getenv("RUSTEMUDROID_QA_ASG_SPIN_RENDERING");
+        if (!env || strcmp(env, "1") != 0) {
+            return false;
+        }
+        if (RustEmuDroidQaAsgSpinUs() <= 0) {
+            GFXSTREAM_WARNING(
+                "RustEmuDroid QA: RUSTEMUDROID_QA_ASG_SPIN_RENDERING has no effect without "
+                "RUSTEMUDROID_QA_ASG_SPIN_US");
+            return false;
+        }
+        GFXSTREAM_WARNING(
+            "RustEmuDroid QA: ASG consumer advertises RENDERING while spinning, grace_us=%lld",
+            (long long)kQaSpinRenderingGraceUs);
+        return true;
+    }();
+    return sOn;
+}
