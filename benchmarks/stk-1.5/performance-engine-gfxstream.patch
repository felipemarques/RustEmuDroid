+// RustEmuDroid QA (RUSTEMUDROID_QA_READBACK_UNLOCK=1): create (once) the private command
+// buffer/fence and (re)size the private staging buffer. Caller holds mQaReadbackMutex and mMutex.
+bool VkEmulation::qaPrepareScaledReadbackLocked(VkDeviceSize size) {
+    if (size > kDefaultStagingBufferSize) {
+        return false;
+    }
+    if (mQaReadbackCommandPool == VK_NULL_HANDLE) {
+        const VkCommandPoolCreateInfo poolInfo = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+            .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+            .queueFamilyIndex = mQueueFamilyIndex,
+        };
+        if (mDvk->vkCreateCommandPool(mDevice, &poolInfo, nullptr, &mQaReadbackCommandPool) !=
+            VK_SUCCESS) {
+            mQaReadbackCommandPool = VK_NULL_HANDLE;
+            return false;
+        }
+        const VkCommandBufferAllocateInfo bufferInfo = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = mQaReadbackCommandPool,
+            .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+            .commandBufferCount = 1,
+        };
+        const VkFenceCreateInfo fenceInfo = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        if (mDvk->vkAllocateCommandBuffers(mDevice, &bufferInfo, &mQaReadbackCommandBuffer) !=
+                VK_SUCCESS ||
+            mDvk->vkCreateFence(mDevice, &fenceInfo, nullptr, &mQaReadbackFence) != VK_SUCCESS) {
+            if (mQaReadbackFence != VK_NULL_HANDLE) {
+                mDvk->vkDestroyFence(mDevice, mQaReadbackFence, nullptr);
+                mQaReadbackFence = VK_NULL_HANDLE;
+            }
+            mDvk->vkDestroyCommandPool(mDevice, mQaReadbackCommandPool, nullptr);
+            mQaReadbackCommandPool = VK_NULL_HANDLE;
+            mQaReadbackCommandBuffer = VK_NULL_HANDLE;
+            return false;
+        }
+        GFXSTREAM_WARNING(
+            "RustEmuDroid QA: Vulkan scaled readback releases the emulation lock while waiting");
+    }
+    if (size > mQaReadbackStagingSize) {
+        mQaReadbackStaging.destroy(mDvk, mDevice);
+        mQaReadbackStagingSize = 0;
+        if (!mQaReadbackStaging.create(mDvk, mDevice, &mDeviceInfo.memProps, mDebugUtilsHelper,
+                                       size) ||
+            !mQaReadbackStaging.mMappedPtr) {
+            mQaReadbackStaging.destroy(mDvk, mDevice);
+            return false;
+        }
+        mQaReadbackStagingSize = size;
+    }
+    return true;
+}
