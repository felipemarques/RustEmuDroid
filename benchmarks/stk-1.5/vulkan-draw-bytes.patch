diff --git a/lib/graphics_engine/include/ge_qa_draw_bytes.hpp b/lib/graphics_engine/include/ge_qa_draw_bytes.hpp
new file mode 100644
--- /dev/null
+++ b/lib/graphics_engine/include/ge_qa_draw_bytes.hpp
@@ -0,0 +1,59 @@
+#ifndef GE_QA_DRAW_BYTES_HPP
+#define GE_QA_DRAW_BYTES_HPP
+#ifdef __ANDROID__
+
+#include <cstddef>
+#include <cstdint>
+#include <ostream>
+#include <vector>
+
+namespace GeQaDrawBytes
+{
+struct Frame
+{
+    std::uint64_t storage_generate_calls = 0;
+    std::uint64_t storage_attempts = 0;
+    std::uint64_t storage_skinning_bytes = 0;
+    std::uint64_t storage_object_bytes = 0;
+    std::uint64_t storage_material_bytes = 0;
+    std::uint64_t upload_calls = 0;
+    std::uint64_t uniform_bytes = 0;
+    std::uint64_t indirect_bytes = 0;
+};
+
+inline bool enabled = false;
+inline std::vector<Frame> frames;
+inline thread_local Frame* current = nullptr;
+
+inline void reset(std::size_t capacity)
+{
+    current = nullptr;
+    frames.assign(capacity, Frame{});
+}
+
+inline void next(std::size_t slot, bool recording)
+{
+    current = nullptr;
+    frames[slot] = {};
+    if (recording)
+        current = &frames[slot];
+}
+
+inline void writeHeader(std::ostream& out)
+{
+    out << "frame,storage_generate_calls,storage_attempts,storage_skinning_bytes,"
+           "storage_object_bytes,storage_material_bytes,upload_calls,uniform_bytes,"
+           "indirect_bytes\n";
+}
+
+inline void writeRow(std::ostream& out, std::size_t index, std::size_t slot)
+{
+    const Frame& data = frames[slot];
+    out << index << ',' << data.storage_generate_calls << ',' << data.storage_attempts
+        << ',' << data.storage_skinning_bytes << ',' << data.storage_object_bytes
+        << ',' << data.storage_material_bytes << ',' << data.upload_calls
+        << ',' << data.uniform_bytes << ',' << data.indirect_bytes << '\n';
+}
+}
+#endif
+#endif
