+namespace StkQaCpu
+{
+    std::atomic<bool> frame_totals_only{false};
+
+    // Used only on the main thread. Keep the order for the frame CSV;
+    // computeStableFPS sorts its own copy just as it does for regular scopes.
+    static std::vector<int> frame_times_us;
+    static double begin_ms = 0.0;
+    static bool record_frame = false;
+    static bool have_begin = false;
+
+    void beginFrame()
+    {
+        have_begin = record_frame && UserConfigParams::m_profiler_enabled;
+        if (have_begin)
+            begin_ms = getTimeMilliseconds();
+    }
+
+    void endFrame()
+    {
+        // Profiling starts and stops during the race update. Skip any frame
+        // whose beginning or end falls outside that interval.
+        if (!have_begin || !UserConfigParams::m_profiler_enabled)
+            return;
+        const int elapsed_us = int((getTimeMilliseconds() - begin_ms) * 1000);
+        if (elapsed_us > 0)
+            frame_times_us.push_back(elapsed_us);
+        have_begin = false;
+    }
+}
