@@ -7,17 +7,84 @@
 #include <vector>
 #include <functional>
 
+#ifdef __ANDROID__
+#include <atomic>
+#include <cstdio>
+#include "../source/Irrlicht/os.h"
+#endif
+
 namespace GE
 {
+#ifdef __ANDROID__
+namespace
+{
+std::atomic<bool> memory_probe_enabled(false);
+std::atomic<unsigned> memory_probe_allocations(0);
+
+void logDrawMemory(GEVulkanDriver* vk, const char* role, const char* location,
+                   unsigned slot, VkBufferUsageFlags usage, VkDeviceSize bytes,
+                   const VmaAllocationCreateInfo& request, VkBuffer buffer,
+                   VmaAllocation allocation)
+{
+    if (!role || !memory_probe_enabled.load(std::memory_order_relaxed))
+        return;
+
+    VmaAllocator vma = vk->getVmaAllocator();
+    VmaAllocationInfo info = {};
+    vmaGetAllocationInfo(vma, allocation, &info);
+    const VkPhysicalDeviceMemoryProperties* properties = nullptr;
+    vmaGetMemoryProperties(vma, &properties);
+    VkMemoryRequirements requirements = {};
+    vkGetBufferMemoryRequirements(vk->getDevice(), buffer, &requirements);
+    if (info.memoryType >= properties->memoryTypeCount)
+    {
+        irr::os::Printer::log("STK QA DRAW MEMORY V1", "invalid_memory_type");
+        return;
+    }
+
+    const VkMemoryType type = properties->memoryTypes[info.memoryType];
+    char detail[544];
+    std::snprintf(detail, sizeof(detail),
+        "allocation=%u role=%s location=%s slot=%u usage=0x%08x requested_bytes=%llu "
+        "required_bytes=%llu required_alignment=%llu memory_type_bits=0x%08x "
+        "vma_allowed_bits=0x%08x vma_flags=0x%08x vma_usage=%u "
+        "vma_required_flags=0x%08x vma_preferred_flags=0x%08x "
+        "chosen_type=%u heap_index=%u heap_flags=0x%08x type_flags=0x%08x "
+        "allocated_bytes=%llu mapped=%u",
+        memory_probe_allocations.fetch_add(1, std::memory_order_relaxed),
+        role, location, slot, static_cast<unsigned>(usage),
+        static_cast<unsigned long long>(bytes),
+        static_cast<unsigned long long>(requirements.size),
+        static_cast<unsigned long long>(requirements.alignment),
+        static_cast<unsigned>(requirements.memoryTypeBits),
+        static_cast<unsigned>(request.memoryTypeBits),
+        static_cast<unsigned>(request.flags), static_cast<unsigned>(request.usage),
+        static_cast<unsigned>(request.requiredFlags), static_cast<unsigned>(request.preferredFlags),
+        static_cast<unsigned>(info.memoryType), static_cast<unsigned>(type.heapIndex),
+        static_cast<unsigned>(properties->memoryHeaps[type.heapIndex].flags),
+        static_cast<unsigned>(type.propertyFlags), static_cast<unsigned long long>(info.size),
+        info.pMappedData == nullptr ? 0u : 1u);
+    irr::os::Printer::log("STK QA DRAW MEMORY V1", detail);
+}
+}
+
+void enableDrawMemoryProbe()
+{
+    memory_probe_enabled.store(true, std::memory_order_relaxed);
+}
+#endif
