@@ -0,0 +1,55 @@
+#ifndef STK_QA_DRAW_ALL_HPP
+#define STK_QA_DRAW_ALL_HPP
+
+#include <cstddef>
+#include <cstdint>
+#include <iosfwd>
+
+namespace StkQaDrawAll
+{
+    extern bool enabled;
+    extern thread_local int armed_slot;
+    enum class Phase : unsigned
+    {
+        UpdateCache, FindCamera, OnAnimate, RenderCameraAndFindDrawCall,
+        Prepare, OnRegisterSceneNode, Generate, Count
+    };
+
+    struct Stamp { std::int64_t elapsed_ns, cpu_ns; };
+    struct Sample;
+
+    void reset(int capacity);
+    void clearSlot(int slot);
+    void writeHeader(std::ostream& out);
+    void writeRow(std::ostream& out, std::size_t row, int slot);
+
+    // Arms just the next drawAllInternal on the current thread.
+    class Call
+    {
+        const int m_slot;
+    public:
+        explicit Call(int slot) : m_slot(slot)
+        {
+            if (m_slot >= 0)
+                armed_slot = m_slot;
+        }
+        ~Call()
+        {
+            if (m_slot >= 0)
+                armed_slot = -1;
+        }
+        Call(const Call&) = delete;
+        Call& operator=(const Call&) = delete;
+    };
+
+    class Measurement
+    {
+        Sample* m_sample = nullptr;
+        Stamp m_previous{};
+    public:
+        explicit Measurement(int slot);
+        explicit operator bool() const { return m_sample != nullptr; }
+        void endPhase(Phase phase);
+    };
+}
+#endif
--- /dev/null
+++ b/src/utils/qa_draw_all.cpp
@@ -0,0 +1,124 @@
+#ifdef __ANDROID__
+#include "utils/qa_draw_all.hpp"
+
+#include <ostream>
+#include <time.h>
+#include <vector>
+
+namespace StkQaDrawAll
+{
+    constexpr unsigned PHASES = static_cast<unsigned>(Phase::Count);
+    constexpr unsigned COMPLETE = (1u << PHASES) - 1;
+
+    struct Sample
+    {
+        bool called = false;
+        bool clock_error = false;
+        unsigned mask = 0;
+        Stamp phase[PHASES]{};
+    };
+
+    bool enabled = false;
+    static std::vector<Sample> samples;
+    thread_local int armed_slot = -1;
+
+    static std::int64_t ns(const timespec& time)
+    {
+        return static_cast<std::int64_t>(time.tv_sec) * 1000000000 + time.tv_nsec;
+    }
+
+    static bool readClocks(Stamp& stamp)
+    {
+        timespec elapsed, cpu;
+        if (clock_gettime(CLOCK_MONOTONIC, &elapsed) != 0 ||
+            clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu) != 0)
+            return false;
+        stamp = {ns(elapsed), ns(cpu)};
+        return true;
+    }
+
+    void reset(int capacity)
+    {
+        samples.assign(capacity, Sample{});
+    }
+
+    void clearSlot(int slot)
+    {
+        if (!samples.empty())
+            samples[slot] = Sample{};
+    }
+
+    Measurement::Measurement(int slot)
+    {
+        if (slot < 0)
+            return;
+        armed_slot = -1;
+        if (static_cast<std::size_t>(slot) >= samples.size())
+            return;
+        m_sample = &samples[slot];
+        m_sample->called = true;
+        if (!readClocks(m_previous))
+        {
+            m_sample->clock_error = true;
+            m_sample = nullptr;
+        }
+    }
+
+    void Measurement::endPhase(Phase phase)
+    {
+        if (!m_sample)
+            return;
+        Stamp next;
+        if (!readClocks(next) || next.elapsed_ns < m_previous.elapsed_ns ||
+            next.cpu_ns < m_previous.cpu_ns)
+        {
+            m_sample->clock_error = true;
+            m_sample = nullptr;
+            return;
+        }
+        const unsigned index = static_cast<unsigned>(phase);
+        m_sample->phase[index] = {next.elapsed_ns - m_previous.elapsed_ns,
+                                  next.cpu_ns - m_previous.cpu_ns};
+        m_sample->mask |= 1u << index;
+        m_previous = next;
+    }
+
+    void writeHeader(std::ostream& out)
+    {
+        out << "profiler_row,slot,status,mask,"
+            << "update_cache_elapsed_ns,update_cache_cpu_ns,find_camera_elapsed_ns,find_camera_cpu_ns,"
+            << "on_animate_elapsed_ns,on_animate_cpu_ns,camera_draw_call_elapsed_ns,camera_draw_call_cpu_ns,"
+            << "prepare_elapsed_ns,prepare_cpu_ns,on_register_scene_node_elapsed_ns,on_register_scene_node_cpu_ns,"
+            << "generate_elapsed_ns,generate_cpu_ns,total_elapsed_ns,total_cpu_ns\n";
+    }
+
+    void writeRow(std::ostream& out, std::size_t row, int slot)
+    {
+        const Sample empty{};
+        const Sample& data = static_cast<std::size_t>(slot) < samples.size()
+                           ? samples[slot] : empty;
+        out << row << ',' << slot << ','
+            << (!data.called ? "not_called" : data.clock_error ? "clock_error"
+                             : data.mask == COMPLETE ? "complete" : "partial")
+            << ',' << data.mask;
+        Stamp total{};
+        for (unsigned i = 0; i < PHASES; ++i)
+        {
+            if ((data.mask & (1u << i)) == 0)
+                out << ",,";
+            else
+            {
+                const Stamp p = data.phase[i];
+                out << ',' << p.elapsed_ns << ',' << p.cpu_ns;
+                total.elapsed_ns += p.elapsed_ns;
+                total.cpu_ns += p.cpu_ns;
+            }
+        }
+        if (data.mask == COMPLETE && !data.clock_error)
+            out << ',' << total.elapsed_ns << ',' << total.cpu_ns;
+        else
+            out << ",,";
+        out << '\n';
+    }
+}
+#endif
