+// Keep the marker stack balanced on early returns and exceptions.
+class VulkanEndSceneMarker
+{
+public:
+    explicit VulkanEndSceneMarker(const char* name)
+    {
+        PROFILER_PUSH_CPU_MARKER(name, 0x70, 0xb0, 0xff);
+    }
+
+    ~VulkanEndSceneMarker()
+    {
+        PROFILER_POP_CPU_MARKER();
+    }
+};
+}
