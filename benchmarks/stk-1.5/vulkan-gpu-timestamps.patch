+class GEVulkanTimestampProbe
+{
+    struct Slot
+    {
+        bool recorded = false;
+        bool pending = false;
+    };
+    static constexpr unsigned SLOT_COUNT = GEVulkanDriver::getMaxFrameInFlight();
+    static constexpr unsigned BATCH_SIZE = 64;
+
+    VkDevice m_device;
+    VkQueryPool m_pool = VK_NULL_HANDLE;
+    uint32_t m_bits = 0;
+    std::array<Slot, SLOT_COUNT> m_slots{};
+    std::array<uint64_t, BATCH_SIZE> m_ticks{};
+    unsigned m_buffered = 0;
+    uint64_t m_submitted = 0;
+    uint64_t m_samples = 0;
+    uint64_t m_unavailable = 0;
+    uint64_t m_discarded = 0;
+
+    static void log(const char* message)
+    {
+        os::Printer::log("STK_VK_GPU_V1", message);
+    }
+
+    void flush()
+    {
+        if (m_buffered == 0)
+            return;
+
+        // Each uint64_t fits in at most 20 digits. Keep logcat records whole.
+        char message[16 + 21 * BATCH_SIZE];
+        size_t offset = static_cast<size_t>(std::snprintf(message, sizeof(message), "ticks"));
+        for (unsigned i = 0; i < m_buffered; ++i)
+        {
+            offset += static_cast<size_t>(std::snprintf(
+                message + offset, sizeof(message) - offset, " %" PRIu64, m_ticks[i]));
+        }
+        log(message);
+        m_buffered = 0;
+    }
+
+public:
+    explicit GEVulkanTimestampProbe(VkDevice device) : m_device(device) {}
+
+    bool initialize(VkPhysicalDevice physical_device, uint32_t family,
+                    const VkPhysicalDeviceLimits& limits)
+    {
+        uint32_t count = 0;
+        vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &count, nullptr);
+        std::vector<VkQueueFamilyProperties> properties(count);
+        if (count != 0)
+            vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &count, properties.data());
+
+        if (family < count)
+            m_bits = properties[family].timestampValidBits;
+
+        char message[160];
+        std::snprintf(message, sizeof(message),
+            "queue family=%u valid_bits=%u period_ns=%.9g compute_and_graphics=%u",
+            family, m_bits, static_cast<double>(limits.timestampPeriod),
+            limits.timestampComputeAndGraphics);
+        log(message);
+
+        if (m_bits == 0 || m_bits > 64 ||
+            !std::isfinite(limits.timestampPeriod) || limits.timestampPeriod <= 0.0f ||
+            !vkCreateQueryPool || !vkDestroyQueryPool || !vkCmdResetQueryPool ||
+            !vkCmdWriteTimestamp || !vkGetQueryPoolResults || !vkGetFenceStatus)
+        {
+            log("disabled unsupported");
+            return false;
+        }
+
+        VkQueryPoolCreateInfo info{};
+        info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        info.queryCount = 2 * SLOT_COUNT;
+        const VkResult result = vkCreateQueryPool(m_device, &info, nullptr, &m_pool);
+        if (result != VK_SUCCESS)
+        {
+            m_pool = VK_NULL_HANDLE;
+            std::snprintf(message, sizeof(message), "disabled create_pool=%d", result);
+            log(message);
+            return false;
+        }
+        log("active");
+        return true;
+    }
+
+    bool begin(unsigned slot, VkCommandBuffer command)
+    {
+        // Only record active replay frames. Results can arrive in a later scene.
+        const auto* race = RaceManager::get();
+        const auto* world = World::getWorld();
+        if (!race || !race->isBenchmarking() || !world || !world->isRacePhase() ||
+            m_slots[slot].pending)
+            return false;
+
+        const uint32_t first = 2 * slot;
+        vkCmdResetQueryPool(command, m_pool, first, 2);
+        // Match the submit's swapchain-image wait stage. Buffer uploads and any
+        // earlier graphics stages that run before it are outside this interval.
+        vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+            m_pool, first);
+        return true;
+    }
+
+    void end(unsigned slot, VkCommandBuffer command)
+    {
+        vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+            m_pool, 2 * slot + 1);
+    }
+
+    void recorded(unsigned slot)
+    {
+        m_slots[slot].recorded = true;
+    }
+
+    void submitted(unsigned slot)
+    {
+        Slot& state = m_slots[slot];
+        if (!state.recorded)
+            return;
+
+        state.recorded = false;
+        state.pending = true;
+        ++m_submitted;
+    }
+
+    void collect(unsigned slot)
+    {
+        Slot& state = m_slots[slot];
+        if (!state.pending)
+            return;
+
+        state.pending = false;
+        uint64_t words[2][2]{};
+        const VkResult result = vkGetQueryPoolResults(m_device, m_pool, 2 * slot, 2,
+            sizeof(words), words, sizeof(words[0]),
+            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        if (result != VK_SUCCESS || words[0][1] == 0 || words[1][1] == 0)
+        {
+            ++m_unavailable;
+            return;
+        }
+
+        uint64_t delta = words[1][0] - words[0][0];
+        if (m_bits < 64)
+            delta &= (uint64_t{1} << m_bits) - 1;
+        m_ticks[m_buffered++] = delta;
+        ++m_samples;
+        if (m_buffered == BATCH_SIZE)
+            flush();
+    }
+
+    // Called before replacing fences so old slots cannot read through new ones.
+    // An existing swapchain idle wait normally makes every fence signaled.
+    void retire(const std::vector<VkFence>& fences)
+    {
+        for (unsigned i = 0; i < SLOT_COUNT; ++i)
+        {
+            if (m_slots[i].pending)
+            {
+                if (i < fences.size() && vkGetFenceStatus(m_device, fences[i]) == VK_SUCCESS)
+                    collect(i);
+                else
+                    ++m_discarded;
+            }
+            m_slots[i] = {};
+        }
+        flush();
+    }
+
+    void finish()
+    {
+        char message[176];
+        std::snprintf(message, sizeof(message),
+            "end submitted=%" PRIu64 " samples=%" PRIu64 " unavailable=%" PRIu64
+            " discarded=%" PRIu64, m_submitted, m_samples, m_unavailable, m_discarded);
+        log(message);
+        vkDestroyQueryPool(m_device, m_pool, nullptr);
+    }
+
+    bool pending() const
+    {
+        return std::any_of(m_slots.begin(), m_slots.end(), [](const Slot& s) { return s.pending; });
+    }
+};
+} // namespace GE
+#else
+namespace GE { class GEVulkanTimestampProbe {}; }
+#endif
 
