  "default_on_changes": [
    {"name": "P0", "module": "qemu", "description": "Every RustEmuDroid one-time proof and diagnostic line of QEMU is formatted as one line, written with one call and flushed at once (util/qemu-error.c helpers). Windows QEMU fully buffers stderr after os_set_line_buffering(), so these lines otherwise appeared only at exit. Text of the lines is unchanged."}
